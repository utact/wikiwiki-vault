{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"$CLAUDE_PROJECT_DIR\" python -X utf8 \"$CLAUDE_PROJECT_DIR/scripts/review_guard.py\"",
            "timeout": 30,
            "statusMessage": "Checking the reviewed status rule"
          }
        ]
      }
    ]
  }
}

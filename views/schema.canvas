		},
		{
			"id": "16bf77995288954a",
			"type": "text",
			"text": "### Work\n\n`eli:Work` (abstract)\n\n법령과 그 하위 단위의 공통 상위 class",
			"x": 4140,
			"y": 100,
			"width": 320,

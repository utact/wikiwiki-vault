# cq-13: 피보험자격 상실신고의 상실사유 구분코드에는 무엇이 있는가?
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX eli: <http://data.europa.eu/eli/ontology#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX employment: <https://w3id.org/kr-employment/>

SELECT ?item ?label ?notation ?source WHERE {
  {
    BIND(employment:insured-status-loss-reason-codes AS ?item)
  } UNION {
    ?item skos:inScheme employment:insured-status-loss-reason-codes .
  }
  ?item skos:prefLabel ?label .
  OPTIONAL { ?item skos:notation ?notation }
  ?note foaf:primaryTopic ?item ;
        dct:source ?expression .
  ?expression eli:realizes ?source .
}

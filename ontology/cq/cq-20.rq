# cq-20: 사업주가 피보험자격 신고나 이직확인서 발급·제출 의무를 어기면 어떤 제재를 받는가?
PREFIX cpsv: <http://purl.org/vocab/cpsv#>
PREFIX cv: <http://data.europa.eu/m8g/>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX eli: <http://data.europa.eu/eli/ontology#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX employment: <https://w3id.org/kr-employment/>

SELECT ?item ?source WHERE {
  {
    BIND(employment:administrative-fine-imposition AS ?item)
  } UNION {
    employment:administrative-fine-imposition cv:relatedService ?item .
  } UNION {
    employment:administrative-fine-imposition cpsv:follows ?item .
  } UNION {
    employment:administrative-fine-imposition cpsv:follows/employment:appliesWhen ?item .
  } UNION {
    employment:administrative-fine-imposition cv:holdsRequirement ?item .
  } UNION {
    employment:administrative-fine-imposition cv:holdsRequirement/employment:appliesWhen ?item .
  } UNION {
    ?item skos:inScheme employment:fine-violations .
  } UNION {
    ?item skos:inScheme ?reasons .
    VALUES ?reasons { employment:fine-reduction-reasons employment:fine-increase-reasons }
  }
  ?note foaf:primaryTopic ?item ;
        dct:source ?expression .
  ?expression eli:realizes ?source .
}

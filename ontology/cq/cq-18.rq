# cq-18: 구직급여를 받다가 일찍 재취업하면 무엇을 받을 수 있는가?
PREFIX cpsv: <http://purl.org/vocab/cpsv#>
PREFIX cv: <http://data.europa.eu/m8g/>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX eli: <http://data.europa.eu/eli/ontology#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX employment: <https://w3id.org/kr-employment/>

SELECT ?item ?source WHERE {
  {
    BIND(employment:early-reemployment-allowance AS ?item)
  } UNION {
    employment:early-reemployment-allowance cv:holdsRequirement|cpsv:follows|cv:hasInputType ?item .
  } UNION {
    employment:early-reemployment-allowance cpsv:follows/employment:requiredInput ?item .
  } UNION {
    employment:early-reemployment-allowance cv:holdsRequirement/(cv:hasRequirement|employment:appliesWhen|cv:hasConcept)+ ?item .
  } UNION {
    employment:early-reemployment-allowance cv:holdsRequirement/(cv:hasRequirement|employment:appliesWhen|cv:hasConcept)+/dct:conformsTo ?item .
  } UNION {
    employment:early-reemployment-allowance cv:holdsRequirement/(cv:hasRequirement|employment:appliesWhen|cv:hasConcept)+/dct:conformsTo ?scheme .
    ?item skos:inScheme ?scheme .
  }
  ?note foaf:primaryTopic ?item ;
        dct:source ?expression .
  ?expression eli:realizes ?source .
}

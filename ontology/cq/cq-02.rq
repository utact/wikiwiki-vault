# cq-02: 이직한 근로자인 피보험자가 구직급여를 받으려면 어떤 요건을 모두 갖춰야 하는가?
PREFIX cv: <http://data.europa.eu/m8g/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX employment: <https://w3id.org/kr-employment/>

SELECT ?item ?label ?source WHERE {
  employment:job-seeking-benefit cv:holdsRequirement ?eligibility .
  ?eligibility cv:hasRequirement ?item .
  ?item skos:prefLabel ?label ;
        cv:isDerivedFrom ?source .
  FILTER NOT EXISTS { ?eligibility employment:appliesWhen employment:daily-worker-at-separation }
}

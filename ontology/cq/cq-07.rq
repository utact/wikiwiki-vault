# cq-07: 구직급여를 받기까지 어떤 절차를 어떤 순서로 거치는가?
PREFIX cv: <http://data.europa.eu/m8g/>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX eli: <http://data.europa.eu/eli/ontology#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX employment: <https://w3id.org/kr-employment/>

SELECT ?item ?source WHERE {
  {
    employment:job-seeking-benefit dct:requires* ?item .
  } UNION {
    employment:job-seeking-benefit dct:requires* ?service .
    ?item dct:hasPart ?service .
  } UNION {
    employment:job-seeking-benefit dct:requires*/dct:hasPart ?item .
  } UNION {
    employment:job-seeking-benefit dct:requires* ?service .
    ?service cv:hasInputType ?item .
  } UNION {
    employment:job-seeking-benefit cv:holdsRequirement ?item .
    ?item a cv:Constraint .
    FILTER NOT EXISTS { ?item employment:appliesWhen employment:construction-daily-worker-at-separation }
  }
  ?note foaf:primaryTopic ?item ;
        dct:source ?expression .
  ?expression eli:realizes ?source .
}

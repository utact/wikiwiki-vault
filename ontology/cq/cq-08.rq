# cq-08: 구직급여일액은 어떻게 산정하는가?
PREFIX cpsv: <http://purl.org/vocab/cpsv#>
PREFIX cv: <http://data.europa.eu/m8g/>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX eli: <http://data.europa.eu/eli/ontology#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX employment: <https://w3id.org/kr-employment/>

SELECT ?item ?source WHERE {
  {
    employment:job-seeking-benefit cpsv:follows ?item .
    ?item employment:variable ?variable .
    VALUES ?variable { employment:base-daily-wage employment:daily-job-seeking-benefit }
    FILTER NOT EXISTS { ?item employment:appliesWhen employment:daily-worker-at-separation }
  }
  UNION
  { ?item cv:constrains employment:base-daily-wage }
  ?note foaf:primaryTopic ?item ;
        dct:source ?expression .
  ?expression eli:realizes ?source .
}
